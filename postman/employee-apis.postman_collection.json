{
  "info": {
    "_postman_id": "f421397a-5391-46ef-a432-11c762725ec0",
    "name": "Dverif Employee APIs",
    "description": "Employee self-service API collection for Dverif. Import EMPLOYEE-API-GUIDE.md alongside this collection. Base URL defaults to http://localhost:5000/api/v1. Employee access token is read from the active Postman environment variable accessToken. No real credentials or tokens are included.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Authentication and profile",
      "description": "Sign in as a regular organization user whose org_role is employee. Login sends an OTP to the account email; Verify OTP stores the access token in the active environment.",
      "item": [
        {
          "name": "Login - request email OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employeeEmail}}\",\n  \"password\": \"{{employeePassword}}\",\n  \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Use a locally-created Postman environment for employeeEmail and employeePassword. Successful password validation sends an OTP; it does not yet return the access token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login request accepted', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  if (data.identity_id) pm.environment.set('identityId', data.identity_id);",
                  "  if (data.identity_type) pm.environment.set('identityType', data.identity_type);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP - save access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity_type\": \"{{identityType}}\",\n  \"identity_id\": \"{{identityId}}\",\n  \"otp\": \"{{otp}}\",\n  \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Enter the one-time code emailed to the employee in the environment variable otp. A successful response saves data.token as accessToken in the active environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verified and access token saved', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  const data = body.data || body;",
                  "  pm.expect(data.token).to.be.a('string').and.not.empty;",
                  "  pm.environment.set('accessToken', data.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identity_type\": \"{{identityType}}\",\n  \"identity_id\": \"{{identityId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend-otp"
              ]
            }
          }
        },
        {
          "name": "Request password reset",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{employeeEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "forgot-password"
              ]
            },
            "description": "Sends a password reset email. Use the reset token from that email in Reset password."
          }
        },
        {
          "name": "Reset password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/reset-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "reset-password"
              ]
            },
            "description": "Requires the unused, unexpired token from the password reset email and a password meeting the server policy."
          }
        },
        {
          "name": "Check employee invite token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/user/invite-status?token={{inviteToken}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "invite-status"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "{{inviteToken}}"
                }
              ]
            }
          }
        },
        {
          "name": "Set password from employee invite",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{inviteToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/user/set-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "set-password"
              ]
            },
            "description": "For a new employee account. Uses an unused, unexpired invite token and the server's password policy."
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Uses the HttpOnly refresh cookie set during OTP verification. Keep Postman's cookie jar enabled for the API host."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh token response saved when returned', function () {",
                  "  if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "    const body = pm.response.json();",
                  "    const data = body.data || body;",
                  "    if (data.accessToken || data.token) pm.environment.set('accessToken', data.accessToken || data.token);",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/user/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "user",
                "logout"
              ]
            },
            "description": "Requires the access token and clears/revokes the user session refresh token."
          }
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            }
          }
        },
