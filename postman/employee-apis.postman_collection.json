            "body": {
              "mode": "raw",
              "raw": "{\n  \"language\": \"en\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/preferred-language",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "preferred-language"
              ]
            },
            "description": "Allowed language values: en or ur."
          }
        }
      ]
    },
