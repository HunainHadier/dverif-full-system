          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "full_name",
                  "value": "Employee Name",
                  "type": "text"
                },
                {
                  "key": "phone",
                  "value": "03001234567",
                  "type": "text"
                },
                {
                  "key": "profile_image",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "me"
              ]
            },
            "description": "Only full_name, phone and optional profile_image are editable. Email cannot be changed. Remove the profile_image form-data row if no image is being uploaded."
          }
        },
        {
          "name": "Set preferred language",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
